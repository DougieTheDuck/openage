!version 0.2.0

import engine.ability.property.type
import engine.ability.type
import engine.util.game_entity
import engine.util.graphics
import engine.util.selection_box.type
import fvd.data.terrain

Builder(engine.util.game_entity.GameEntity):
    GameEntity.types = {}
    GameEntity.abilities = {Idle, Move, Turn, Selectable}
    GameEntity.modifiers = {}
    GameEntity.variants = {}

    Idle(engine.ability.type.Idle):
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Animation}

            Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/builder.sprite"

    Move(engine.ability.type.Move):
        Move.speed = 3.0
        Move.modes = {}
        Move.path_type = fvd.data.terrain.Land
        Ability.properties = {engine.ability.property.type.Animated: Builder.Idle.Animated}

    Turn(engine.ability.type.Turn):
        Turn.turn_speed = inf

    Selectable(engine.ability.type.Selectable):
        Selectable.selection_box = Box

        Box(engine.util.selection_box.type.Rectangle):
            Rectangle.width = 0.5
            Rectangle.height = 0.5

Tower(engine.util.game_entity.GameEntity):
    GameEntity.types = {}
    GameEntity.abilities = {Idle, Selectable}
    GameEntity.modifiers = {}
    GameEntity.variants = {}

    Idle(engine.ability.type.Idle):
        Ability.properties = {engine.ability.property.type.Animated: Animated}

        Animated(engine.ability.property.type.Animated):
            Animated.animations = {Animation}

            Animation(engine.util.graphics.Animation):
                Animation.sprite = "../../../fvd/graphics/tower.sprite"

    Selectable(engine.ability.type.Selectable):
        Selectable.selection_box = Box

        Box(engine.util.selection_box.type.Rectangle):
            Rectangle.width = 1.0
            Rectangle.height = 1.0
