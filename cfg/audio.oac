# FVD sound volumes, as percentages (0-100). Press M in a match to mute.
# Override in your own config folder (e.g. ~/.config/openage/audio.oac).
set AUDIO_MASTER_VOLUME 100
set AUDIO_MUSIC_VOLUME 70
set AUDIO_EFFECTS_VOLUME 100
